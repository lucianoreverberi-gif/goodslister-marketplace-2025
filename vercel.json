{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-boosts",
      "schedule": "0 2 * * *"    },    {      "path": "/api/cron/rental-reminders",      "schedule": "0 14 * * *"    },    {      "path": "/api/cron/review-requests",      "schedule": "0 16 * * *"
    }
  ]
}
